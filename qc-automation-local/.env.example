# Environment Variables — SUNTEK AI QC
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Multi-merchant configuration ──────────────────────────────────────────────
# Merchant URLs are defined per-merchant in merchants/<slug>/config.js.
# There is no global BASE_URL — each merchant carries its own URL.
#
# To add a new website:
#   1. Copy merchants/outset/ to merchants/<your-slug>/
#   2. Edit merchants/<your-slug>/config.js and locators.js
#   3. Add '<your-slug>' to ACTIVE_MERCHANTS in merchants/index.js
#   4. Run: npx playwright test --list

# ── Active merchant filter (optional) ─────────────────────────────────────────
# Leave blank to run ALL registered merchants (ACTIVE_MERCHANTS in
# merchants/index.js: outset, revitin, koh, abc).
# Set to a slug to restrict the run to a single merchant (useful in CI).
# Note: the npm scripts that go through scripts/run-project.js (test:smoke,
# test:desktop, test:mobile, ...) default to 'outset' when this is blank.
# Example: MERCHANT=outset
MERCHANT=outset

# ── Staging vs Production switch ──────────────────────────────────────────────
# Set to true to run all tests against each merchant's staging URL instead of
# their production URL. Staging URLs are defined in merchants/<slug>/config.js
# Example: USE_STAGING=true npm test
USE_STAGING=false

# ── Rate limiting (Cloudflare 429 guard) ──────────────────────────────────────
# Pause before every test, and extra cooldown before the next test after one
# was throttled by a 429. Raise these if full runs still hit "Too Many Requests".
# Set to 0 to disable. See utils/rate-limit.js.
REQUEST_PACING_MS=500
RATE_LIMIT_COOLDOWN_MS=20000

# ── Marketing popups ──────────────────────────────────────────────────────────
# Popups (KOH / Revitin "15% off") are closed automatically before each test.
# They only appear in headed browsers, a few seconds after load: on merchants with
# features.popup = true, headed runs wait up to this long (once per test) for one to
# appear. 0 = never wait (still closes any popup that is already visible).
POPUP_WAIT_MS=12000

# ── Claude AI ─────────────────────────────────────────────────────────────────
# Your Anthropic API key for Claude-powered failure analysis.
# Obtain from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Claude model to use for RCA (default: claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# ── Slack ─────────────────────────────────────────────────────────────────────
# Incoming webhook URL for Slack QA report notifications.
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/HERE

# ── CI / GitHub Actions ───────────────────────────────────────────────────────
# Set automatically by GitHub Actions. Do not set manually.
# CI=true
