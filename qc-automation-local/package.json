{
  "name": "suntek-ai-qc",
  "version": "1.0.0",
  "description": "SUNTEK AI QC — Multi-merchant Shopify regression suite powered by Playwright and Claude",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "node scripts/run-project.js desktop --grep \"@smoke\"",
    "test:regression": "node scripts/run-suite.js regression",
    "test:full": "node scripts/run-suite.js full",
    "test:module": "node scripts/run-suite.js",
    "test:watch": "node scripts/run-suite.js smoke desktop --watch",
    "test:tiers": "node scripts/run-suite.js --list",
    "test:desktop": "node scripts/run-project.js desktop",
    "test:mobile": "node scripts/run-project.js mobile",
    "test:headed": "node scripts/run-project.js desktop --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report reports/html",
    "test:visual": "node scripts/run-project.js desktop tests/visual.spec.js",
    "test:visual:update": "node scripts/run-project.js desktop tests/visual.spec.js --update-snapshots",
    "test:technical": "node scripts/run-project.js desktop tests/technical.spec.js",
    "test:codegen": "playwright codegen",
    "analyze:failures": "node ai/analyze-failure.js",
    "generate:report": "node ai/generate-report.js",
    "notify:slack": "node notifications/slack.js",
    "qa:report": "node qa-report.js",
    "console": "node console/server.js",
    "console:share": "ngrok http 4000 --url https://trial-bungee-baked.ngrok-free.dev"
  },
  "keywords": [
    "playwright",
    "automation",
    "qa",
    "shopify",
    "regression",
    "suntek",
    "claude"
  ],
  "author": "Suntek AI",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
